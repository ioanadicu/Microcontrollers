00000004:             ; ; Display Operations Library
00000004:             ; ; Maria-Ioana Dicu
00000004:             ; ; 12 March 2026
00000004:             ; ;
00000004:             ; ; Provides helper routines for driving the LCD display:
00000004:             ; ;   - printString(pointer)
00000004:             ; ;       Prints a null-terminated string character by character.
00000004:             ; ;   - lcdSendCommand(value, control_signals)
00000004:             ; ;       Sends either data or a command to the LCD.
00000004:             ; ;   - waiting_loop()
00000004:             ; ;       Small delay loop used to stretch pulse width and separate enable pulses.
00000004:             ; ;
00000004:             ; ; Reference:
00000004:             ; ;   HD44780 LCD controller documentation:
00000004:             ; ;   https://cdn.sparkfun.com/assets/9/5/f/7/b/HD44780.pdf
00000004:             ; ;
00000004:             ; ; Notes:
00000004:             ; ;   - Delay value may still need tuning depending on hardware timing.
00000004:             ; ; =============================================================================
