00040178: 00000073    ;     ecall
0004017C: 0100006F    ;     j       wait_duration
00040180:             ; 
00040180:             ; play_rest
00040180: 00000513    ;     li      a0, 0               ; Period 0 = Silence
00040184: 00500893    ;     li      a7, ECALL_PLAY_NOTE
00040188: 00000073    ;     ecall
0004018C:             ; 
