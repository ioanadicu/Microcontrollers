000400A0:             ; INCLUDE         UserSpaceLib.s
000400A0:             ; ; =============================================================================
000400A0:             ; ; User Space Screen Routines
000400A0:             ; ; Maria-Ioana Dicu
000400A0:             ; ; 12 March 2026
000400A0:             ; ;
000400A0:             ; ; This file contains helper routines used to print common screens and values
000400A0:             ; ; through the display-related ecalls.
000400A0:             ; ;
000400A0:             ; ; The main purpose of these functions is to keep the main program shorter and
000400A0:             ; ; avoid repeating the same display-printing sequences multiple times.
000400A0:             ; ;
000400A0:             ; ; Functions provided:
000400A0:             ; ;   - printDec(value)
000400A0:             ; ;       Prints an unsigned decimal number digit by digit.
000400A0:             ; ;
000400A0:             ; ;   - displayTime()
000400A0:             ; ;       Prints the current timer values using the display ecalls.
000400A0:             ; ;
000400A0:             ; ;   - displayStartScreen()
000400A0:             ; ;       Prints the start screen.
000400A0:             ; ;
000400A0:             ; ;   - displayPauseScreen()
000400A0:             ; ;       Prints the pause screen.
000400A0:             ; ;
000400A0:             ; ; Notes:
000400A0:             ; ;   - These routines do not directly control the LCD hardware.
000400A0:             ; ;   - They rely on ecalls that perform display operations such as clearing the
000400A0:             ; ;     screen, printing strings, printing characters, and moving to the next line.
000400A0:             ; ; =============================================================================
000400A0:             ; 
000400A0:             ; 
000400A0:             ; ; =============================================================================
000400A0:             ; ; printDec
000400A0:             ; ; =============================================================================
000400A0:             ; ; Prints an unsigned decimal number.
000400A0:             ; ; The digits are extracted using repeated division by 10 and temporarily
000400A0:             ; ; stored on the stack so they can be printed in the correct order.
000400A0:             ; ;
000400A0:             ; ; Input:
000400A0:             ; ;   a0 = integer value to print
000400A0:             ; ;
000400A0:             ; ; Registers used:
000400A0:             ; ;   s0 = working copy of the value
000400A0:             ; ;   s1 = digit counter
000400A0:             ; ; =============================================================================
000400A0:             ; 
000400A0:             ; printDec
000400A0: FF410113    ;     subi    sp, sp, 12
000400A4: 00112423    ;     sw      ra,  8[sp]
000400A8: 00812223    ;     sw      s0,  4[sp]
000400AC: 00912023    ;     sw      s1,  0[sp]
000400B0:             ; 
000400B0: 00050413    ;     mv      s0, a0          ; s0 = value being printed
000400B4: 00000493    ;     li      s1, 0           ; s1 = digit counter
000400B8:             ; 
000400B8:             ;     ; -------------------------------------------------------------------------
000400B8:             ;     ; Special case: value = 0
000400B8:             ;     ; -------------------------------------------------------------------------
000400B8:             ; 
000400B8: 00041A63    ;     bnez    s0, decLoop
000400BC: 03000513    ;     li      a0, '0'
000400C0:             ;     ;li      a1, LIGHT | RS
000400C0:             ; 
000400C0: 00100893    ;     li      a7, ECALL_PRINT_CHAR
000400C4: 00000073    ;     ecall 
000400C8:             ;     
000400C8: 03C0006F    ;     j       decDone
000400CC:             ; 
000400CC:             ; 
000400CC:             ; ; -------------------------------------------------------------------------
000400CC:             ; ; Extract digits and push them onto the stack
000400CC:             ; ; -------------------------------------------------------------------------
000400CC:             ; 
000400CC:             ; decLoop
000400CC: 00A00313    ;     li      t1, 10
000400D0: 026472B3    ;     remu    t0, s0, t1      ; t0 = s0 % 10
000400D4: 02645433    ;     divu    s0, s0, t1      ; s0 = s0 / 10
