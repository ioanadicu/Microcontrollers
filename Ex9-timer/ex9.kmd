00000004:             ; INCLUDE         Definitions.s
00000004:             ; ; =============================================================================
00000004:             ; ; Definitions
00000004:             ; ; Maria-Ioana Dicu
00000004:             ; ; 12 March 2026
00000004:             ; ;
00000004:             ; ; Shared constants used by the Exercise 7 operating-system code, trap handler,
00000004:             ; ; timer setup, interrupt controller and memory-mapped I/O routines.
00000004:             ; ;
00000004:             ; ; This file contains only compile-time constants. It does not reserve memory or
00000004:             ; ; contain executable code.
00000004:             ; ;
00000004:             ; ; Notes:
00000004:             ; ;   - Hardware devices are accessed only from machine mode.
00000004:             ; ;   - The user application should access hardware indirectly through ecalls.
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
