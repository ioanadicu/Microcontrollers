00000038: 00012483    ;     lw      s1,  0[sp]
0000003C: 00412403    ;     lw      s0,  4[sp]
00000040: 00812083    ;     lw      ra,  8[sp]
00000044: 00C10113    ;     addi    sp, sp, 12
00000048:             ; 
