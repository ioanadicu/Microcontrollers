00000504:             ; INCLUDE         OS.s
00000504:             ; ; =============================================================================
00000504:             ; ; Operating System Initialisation
00000504:             ; ; Maria-Ioana Dicu
00000504:             ; ; 12 March 2026
00000504:             ; ;
00000504:             ; ; Performs the machine-mode setup needed before entering the user programme.
00000504:             ; ;
00000504:             ; ; Responsibilities:
00000504:             ; ;   - Configure trap handling through MTVEC.
00000504:             ; ;   - Set up the machine-mode stack through MSCRATCH.
00000504:             ; ;   - Configure the timer to generate 1 ms interrupts.
00000504:             ; ;   - Enable timer interrupts through the interrupt controller.
00000504:             ; ;   - Configure the PIO direction for keypad scanning.
00000504:             ; ;   - Clear keypad debounce state and FIFO pointers.
00000504:             ; ;   - Enter user mode using mret.
00000504:             ; ;
00000504:             ; ; Notes:
00000504:             ; ;   - MSTATUS_MPIE is set instead of MSTATUS_MIE. mret then copies MPIE into
00000504:             ; ;     MIE when entering user mode.
00000504:             ; ;   - Hardware setup is done in machine mode because user mode cannot access
00000504:             ; ;     protected I/O addresses directly.
00000504:             ; ; =============================================================================
00000504:             ; 
00000504:             ; 
00000504:             ; ; =============================================================================
00000504:             ; ; Initialisation
00000504:             ; ; =============================================================================
00000504:             ; 
00000504:             ; initialisation
00000504:             ;     ; -------------------------------------------------------------------------
00000504:             ;     ; Prepare to enter user mode
00000504:             ;     ; -------------------------------------------------------------------------
00000504:             ; 
00000504: 001892B7    ;     li      t0, mppMask
00000508: 67F28293    ; 
0000050C: 3002B073    ;     csrc    MSTATUS, t0            ; Clear MPP bits so mret enters user mode
00000510:             ; 
00000510: 00000297    ;     la      t0, mhandler
00000514: DE028293    ; 
00000518: 30529073    ;     csrw    MTVEC, t0              ; Set trap/interrupt handler entry point
0000051C:             ; 
0000051C: 00000297    ;     la      t0, mstack_base
00000520: 1F828293    ; 
00000524: 34029073    ;     csrw    MSCRATCH, t0           ; Store machine stack pointer in MSCRATCH
00000528:             ; 
00000528:             ; 
00000528:             ;     ; -------------------------------------------------------------------------
00000528:             ;     ; Timer setup: 1 ms interrupt period
00000528:             ;     ; -------------------------------------------------------------------------
00000528:             ; 
00000528: 00010337    ;     li      t1, TIME_PERIPH
0000052C: 20030313    ; 
00000530: 3E700293    ;     li      t0, SCAN_MODULUS
00000534: 00532223    ;     sw      t0, TIME_REG_LIMIT[t1] ; Timer modulus = SCAN_MODULUS + 1
00000538:             ; 
00000538: 00B00293    ;     li      t0, 0b1011
0000053C: 00532A23    ;     sw      t0, TIME_REG_CTRL[t1]  ; Enable timer, modulus mode and interrupts
00000540:             ; 
