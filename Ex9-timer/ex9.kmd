00000004:             ; TIME_REG_CTRL   EQU     0x14
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
00000004:             ; ; Parallel I/O peripheral
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; PIO_BASE        EQU     0x0001_0300
00000004:             ; 
00000004:             ; PIO_DATA        EQU     0x00
00000004:             ; PIO_DIR         EQU     0x04
00000004:             ; PIO_CLR         EQU     0x08
