00000270:             ; ; =============================================================================
00000270:             ; ; fifo_put
00000270:             ; ; =============================================================================
00000270:             ; ; Adds one character to the circular FIFO.
00000270:             ; ;
00000270:             ; ; Input:
00000270:             ; ;   a0 = ASCII character to enqueue
00000270:             ; ;
00000270:             ; ; Behaviour:
00000270:             ; ;   - If the FIFO is full, the new character is dropped.
00000270:             ; ;   - fifo_head points to the next write position.
00000270:             ; ;   - fifo_tail points to the next read position.
00000270:             ; ;
00000270:             ; ; Registers used:
00000270:             ; ;   t0-t5
00000270:             ; ; =============================================================================
00000270:             ; 
00000270:             ; fifo_put
00000270: 00000297    ;     la      t0, fifo_head
00000274: EBC28293    ; 
00000278: 0002A303    ;     lw      t1, [t0]               ; t1 = current head
0000027C:             ; 
0000027C: 00000397    ;     la      t2, fifo_tail
00000280: EB438393    ; 
00000284: 0003AE03    ;     lw      t3, [t2]               ; t3 = current tail
00000288:             ; 
00000288: 00130E93    ;     addi    t4, t1, 1
0000028C: 00FEFE93    ;     andi    t4, t4, 0x0F           ; Wrap around 16-byte buffer
00000290:             ; 
00000290: 01CE8C63    ;     beq     t4, t3, fifo_put_done  ; If next head equals tail, FIFO is full
00000294:             ; 
00000294: 00000F17    ;     la      t5, fifo_buf
00000298: E88F0F13    ; 
0000029C: 006F0F33    ;     add     t5, t5, t1
000002A0: 00AF0023    ;     sb      a0, [t5]               ; Store character at current head
000002A4:             ; 
000002A4: 01D2A023    ;     sw      t4, [t0]               ; Update head
000002A8:             ; 
000002A8:             ; fifo_put_done
000002A8: 00008067    ;     ret
000002AC:             ; 
000002AC:             ; 
000002AC:             ; ; =============================================================================
000002AC:             ; ; fifo_get
000002AC:             ; ; =============================================================================
000002AC:             ; ; Removes and returns one character from the circular FIFO.
000002AC:             ; ;
000002AC:             ; ; Output:
000002AC:             ; ;   a0 = next ASCII character, or 0 if the FIFO is empty
000002AC:             ; ;
000002AC:             ; ; Behaviour:
000002AC:             ; ;   - fifo_head == fifo_tail means the FIFO is empty.
000002AC:             ; ;   - The character byte is not cleared from fifo_buf after reading.
000002AC:             ; ;
000002AC:             ; ; Registers used:
000002AC:             ; ;   t0-t4
000002AC:             ; ; =============================================================================
000002AC:             ; 
000002AC:             ; fifo_get
000002AC: 00000297    ;     la      t0, fifo_head
000002B0: E8028293    ; 
000002B4: 0002A303    ;     lw      t1, [t0]               ; t1 = current head
000002B8:             ; 
000002B8: 00000397    ;     la      t2, fifo_tail
000002BC: E7838393    ; 
000002C0: 0003AE03    ;     lw      t3, [t2]               ; t3 = current tail
000002C4:             ; 
000002C4: 03C30263    ;     beq     t1, t3, fifo_empty
000002C8:             ; 
000002C8: 00000E97    ;     la      t4, fifo_buf
000002CC: E54E8E93    ; 
000002D0: 01CE8EB3    ;     add     t4, t4, t3
000002D4: 000EC503    ;     lbu     a0, [t4]               ; Return oldest unread character
000002D8:             ; 
000002D8: 001E0E13    ;     addi    t3, t3, 1
000002DC: 00FE7E13    ;     andi    t3, t3, 0x0F           ; Wrap around 16-byte buffer
000002E0: 01C3A023    ;     sw      t3, [t2]               ; Update tail
000002E4:             ; 
000002E4: 00008067    ;     ret
000002E8:             ; 
000002E8:             ; fifo_empty
000002E8: 00000513    ;     li      a0, 0
000002EC: 00008067    ;     ret
000002F0:             ; INCLUDE         TrapHandler.s
000002F0:             ; ; =============================================================================
000002F0:             ; ; Trap and Interrupt Handler
000002F0:             ; ; Maria-Ioana Dicu
000002F0:             ; ; 12 March 2026
000002F0:             ; ;
000002F0:             ; ; Handles traps and interrupts for Exercise 7.
000002F0:             ; ;
000002F0:             ; ; Responsibilities:
000002F0:             ; ;   - Save and restore user context when entering machine mode.
000002F0:             ; ;   - Dispatch synchronous traps using MCAUSE.
000002F0:             ; ;   - Handle user-mode ecalls.
000002F0:             ; ;   - Handle timer interrupts and call the keypad scanner.
000002F0:             ; ;   - Return to user mode using mret.
000002F0:             ; ;
000002F0:             ; ; Ecall services:
000002F0:             ; ;   a7 = 0   Clear display
000002F0:             ; ;   a7 = 1   Print character in a0 using LCD control bits in a1
000002F0:             ; ;   a7 = 2   Print null-terminated string pointed to by a0
000002F0:             ; ;   a7 = 3   Move cursor to second line
000002F0:             ; ;   a7 = 4   Get next keypad character from FIFO, returns char in a0 or 0
000002F0:             ; ;
000002F0:             ; ; Notes:
000002F0:             ; ;   - ECALL returns must increment MEPC by 4.
000002F0:             ; ;   - Interrupt returns must not increment MEPC.
000002F0:             ; ;   - ecall_10 saves a0 back into the saved-context slot so the returned
000002F0:             ; ;     character is not overwritten during context restore.
000002F0:             ; ; =============================================================================
000002F0:             ; 
000002F0:             ; 
000002F0:             ; ; =============================================================================
000002F0:             ; ; Ecall table size
000002F0:             ; ; =============================================================================
000002F0:             ; 
000002F0:             ; ecall_max       EQU     (ecall_jump_end - ecall_jump) / 4
000002F0:             ; 
000002F0:             ; 
000002F0:             ; ; =============================================================================
