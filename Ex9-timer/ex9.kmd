00000004:             ; ; =============================================================================
00000004:             ; ; Keypad scan configuration
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; ROW_MASK        EQU     0x00000F00      ; Bits 8-11 are keypad output lines
00000004:             ; COL_MASK        EQU     0x0000F000      ; Bits 12-15 are keypad input lines
00000004:             ; 
00000004:             ; KEY_DIR         EQU     0x0000F000      ; Bits 12-15 input, all other bits output
00000004:             ; 
00000004:             ; SCAN_MODULUS    EQU     999             ; 1 ms interrupt period, assuming 1 us timer ticks
00000004:             ; 
