00000004:             ; ; Timer peripheral
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; TIME_PERIPH     EQU     0x0001_0200
00000004:             ; 
00000004:             ; TIME_REG_LIMIT  EQU     0x04
00000004:             ; TIME_REG_STATUS EQU     0x0C
