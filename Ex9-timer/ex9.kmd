000400F4:             ;     ;li      a1, LIGHT | RS
000400F4:             ; 
000400F4: 00100893    ;     li      a7, ECALL_PRINT_CHAR
000400F8: 00000073    ;     ecall 
000400FC:             ; 
000400FC: FFF48493    ;     addi    s1, s1, -1
00040100: FE0496E3    ;     bnez    s1, printLoop
