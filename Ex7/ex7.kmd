00000004:             ; INCLUDE         DisplayOperations.s
00000004:             ; ; =============================================================================
00000004:             ; ; Display Operations Library
00000004:             ; ; Maria-Ioana Dicu
00000004:             ; ; 12 March 2026
00000004:             ; ;
00000004:             ; ; Provides helper routines for driving the LCD display:
00000004:             ; ;   - printString(pointer)
00000004:             ; ;       Prints a null-terminated string character by character.
00000004:             ; ;   - lcdSendCommand(value, control_signals)
00000004:             ; ;       Sends either data or a command to the LCD.
00000004:             ; ;   - waiting_loop()
00000004:             ; ;       Small delay loop used to stretch pulse width and separate enable pulses.
00000004:             ; ;
00000004:             ; ; Reference:
00000004:             ; ;   HD44780 LCD controller documentation:
00000004:             ; ;   https://cdn.sparkfun.com/assets/9/5/f/7/b/HD44780.pdf
00000004:             ; ;
00000004:             ; ; Notes:
00000004:             ; ;   - Delay value may still need tuning depending on hardware timing.
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
00000004:             ; ; Named constants
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; LCD_DATA        EQU     0x0001_0100         ; Base LCD address
00000004:             ; LCD_BUSY        EQU     0x80                ; Busy flag mask (bit 7)
00000004:             ; DELAY           EQU     0x000690            ; Delay counter value
00000004:             ; SHIFT_NEXT      EQU     0b1100_0000         ; Command to move cursor to second line
00000004:             ; 
00000004:             ; LCD_REG_DATA    EQU     0x0                 ; Data register / status register
00000004:             ; LCD_REG_CTRL    EQU     0x1                 ; Control register
00000004:             ; 
00000004:             ; RW              EQU     0x1                 ; Read/Write control bit
00000004:             ; RS              EQU     0x2                 ; Register Select control bit
00000004:             ; E               EQU     0x4                 ; Enable control bit
00000004:             ; LIGHT           EQU     0x8                 ; Backlight control bit
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
00000004:             ; ; printString
00000004:             ; ; =============================================================================
00000004:             ; ; Prints a null-terminated string to the LCD.
00000004:             ; ;
00000004:             ; ; Input:
00000004:             ; ;   a0 = pointer to string
00000004:             ; ;
00000004:             ; ; Registers used:
00000004:             ; ;   s0 = current string pointer
00000004:             ; ;   s1 = current character
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; printString
00000004: FF410113    ;     subi    sp, sp, 12
00000008: 00112423    ;     sw      ra,  8[sp]  ; Save return address
0000000C: 00812223    ;     sw      s0,  4[sp]  ; Save callee-saved register
00000010: 00912023    ;     sw      s1,  0[sp]  ; Save callee-saved register
00000014:             ; 
00000014: 00050413    ;     mv      s0, a0
00000018: 00040483    ;     lb      s1, [s0]
0000001C:             ; 
0000001C:             ; whileChar
0000001C:             ;     ; Loop until null reached
0000001C: 00048E63    ;     beqz    s1, foundNull
00000020:             ; 
00000020:             ;     ; Print current character
00000020: 00048513    ;     mv      a0, s1
00000024: 00A00593    ;     li      a1, LIGHT | RS
00000028: 024000EF    ;     call    lcdSendCommand
