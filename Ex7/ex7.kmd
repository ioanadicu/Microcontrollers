00000404:             ; ; =============================================================================
00000404:             ; ; Keyboard scan
00000404:             ; ; =============================================================================
00000404:             ; ; Scans all 4 rows once.
00000404:             ; ; For each key:
00000404:             ; ;   history = (history << 1) | sample_bit
00000404:             ; ;   if history == 0xFF and state == 0:
00000404:             ; ;       state = 1
00000404:             ; ;       enqueue ASCII
00000404:             ; ;   if history == 0x00 and state == 1:
00000404:             ; ;       state = 0
00000404:             ; ; =============================================================================
