00000400:             ; ; =============================================================================
00000400:             ; ; Keyboard scan
00000400:             ; ; =============================================================================
00000400:             ; ; Scans all 4 rows once.
00000400:             ; ; For each key:
00000400:             ; ;   history = (history << 1) | sample_bit
00000400:             ; ;   if history == 0xFF and state == 0:
00000400:             ; ;       state = 1
00000400:             ; ;       enqueue ASCII
00000400:             ; ;   if history == 0x00 and state == 1:
00000400:             ; ;       state = 0
00000400:             ; ; =============================================================================
