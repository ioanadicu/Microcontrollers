0004013C: 00200893    ;     li      a7, 2
00040140: 00000073    ;     ecall
00040144:             ; 
00040144: 00300893    ;     li      a7, 3
00040148: 00000073    ;     ecall
0004014C:             ; 
0004014C:             ; main_loop
0004014C: 00A00893    ;     li      a7, 10          ; get next queued key, 0 if none
00040150: 00000073    ;     ecall
00040154:             ; 
00040154: FE050CE3    ;     beqz    a0, main_loop
00040158:             ; 
00040158:             ;     ; print returned character in a0
