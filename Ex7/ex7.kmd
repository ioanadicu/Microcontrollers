000400AC:             ; 
000400AC:             ; INCLUDE UserSpaceLib.s
000400AC:             ; ; =============================================================================
000400AC:             ; ; User Space Screen Routines
000400AC:             ; ; Maria-Ioana Dicu
000400AC:             ; ; 12 March 2026
000400AC:             ; ;
000400AC:             ; ; This file contains helper routines used to print common screens and values
000400AC:             ; ; through the display-related ecalls.
000400AC:             ; ;
000400AC:             ; ; The main purpose of these functions is to keep the main program shorter and
000400AC:             ; ; avoid repeating the same display-printing sequences multiple times.
000400AC:             ; ;
000400AC:             ; ; Functions provided:
000400AC:             ; ;   - printDec(value)
000400AC:             ; ;       Prints an unsigned decimal number digit by digit.
000400AC:             ; ;
000400AC:             ; ;   - displayTime()
000400AC:             ; ;       Prints the current timer values using the display ecalls.
000400AC:             ; ;
000400AC:             ; ;   - displayStartScreen()
000400AC:             ; ;       Prints the start screen.
000400AC:             ; ;
000400AC:             ; ;   - displayPauseScreen()
000400AC:             ; ;       Prints the pause screen.
000400AC:             ; ;
000400AC:             ; ; Notes:
000400AC:             ; ;   - These routines do not directly control the LCD hardware.
000400AC:             ; ;   - They rely on ecalls that perform display operations such as clearing the
000400AC:             ; ;     screen, printing strings, printing characters, and moving to the next line.
000400AC:             ; ; =============================================================================
000400AC:             ; 
000400AC:             ; 
000400AC:             ; ; =============================================================================
000400AC:             ; ; printDec
000400AC:             ; ; =============================================================================
000400AC:             ; ; Prints an unsigned decimal number.
000400AC:             ; ; The digits are extracted using repeated division by 10 and temporarily
000400AC:             ; ; stored on the stack so they can be printed in the correct order.
000400AC:             ; ;
000400AC:             ; ; Input:
000400AC:             ; ;   a0 = integer value to print
000400AC:             ; ;
000400AC:             ; ; Registers used:
000400AC:             ; ;   s0 = working copy of the value
000400AC:             ; ;   s1 = digit counter
000400AC:             ; ; =============================================================================
000400AC:             ; 
000400AC:             ; printDec
000400AC: FF410113    ;     subi    sp, sp, 12
000400B0: 00112423    ;     sw      ra,  8[sp]
000400B4: 00812223    ;     sw      s0,  4[sp]
000400B8: 00912023    ;     sw      s1,  0[sp]
000400BC:             ; 
000400BC: 00050413    ;     mv      s0, a0          ; s0 = value being printed
000400C0: 00000493    ;     li      s1, 0           ; s1 = digit counter
000400C4:             ; 
000400C4:             ;     ; -------------------------------------------------------------------------
000400C4:             ;     ; Special case: value = 0
000400C4:             ;     ; -------------------------------------------------------------------------
000400C4:             ; 
000400C4: 00041C63    ;     bnez    s0, decLoop
000400C8: 03000513    ;     li      a0, '0'
000400CC: 00A00593    ;     li      a1, LIGHT | RS
000400D0:             ; 
000400D0: 00100893    ;     li      a7, 1
000400D4: 00000073    ;     ecall 
000400D8:             ;     
000400D8: 0400006F    ;     j       decDone
000400DC:             ; 
000400DC:             ; 
000400DC:             ; ; -------------------------------------------------------------------------
000400DC:             ; ; Extract digits and push them onto the stack
000400DC:             ; ; -------------------------------------------------------------------------
000400DC:             ; 
000400DC:             ; decLoop
000400DC: 00A00313    ;     li      t1, 10
000400E0: 026472B3    ;     remu    t0, s0, t1      ; t0 = s0 % 10
000400E4: 02645433    ;     divu    s0, s0, t1      ; s0 = s0 / 10
000400E8: 03028293    ;     addi    t0, t0, '0'     ; Convert to ASCII digit
000400EC:             ; 
000400EC: FFC10113    ;     subi    sp, sp, 4
000400F0: 00512023    ;     sw      t0, 0[sp]       ; push digit onto stack
000400F4: 00148493    ;     addi    s1, s1, 1
000400F8: FE0412E3    ;     bnez    s0, decLoop
000400FC:             ; 
000400FC:             ; 
000400FC:             ; ; -------------------------------------------------------------------------
000400FC:             ; ; Pop digits and print them
000400FC:             ; ; -------------------------------------------------------------------------
000400FC:             ; 
000400FC:             ; printLoop
000400FC: 00012503    ;     lw      a0, 0[sp]
00040100: 00410113    ;     addi    sp, sp, 4
00040104: 00A00593    ;     li      a1, LIGHT | RS
00040108:             ; 
00040108: 00100893    ;     li      a7, 1
0004010C: 00000073    ;     ecall 
00040110:             ; 
00040110: FFF48493    ;     addi    s1, s1, -1
00040114: FE0494E3    ;     bnez    s1, printLoop
00040118:             ; 
00040118:             ; decDone
00040118: 00012483    ;     lw      s1,  0[sp]
0004011C: 00412403    ;     lw      s0,  4[sp]
00040120: 00812083    ;     lw      ra,  8[sp]
00040124: 00C10113    ;     addi    sp, sp, 12
00040128: 00008067    ;     ret
