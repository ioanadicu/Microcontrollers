000000BC:             ; INCLUDE DisplayOperations.s                 ; Library with Display Operations
000000BC:             ; ;-----------------------------------------------------------------------------
000000BC:             ; ;       Display Operations Library
000000BC:             ; ;       Maria-Ioana Dicu
000000BC:             ; ;       19 February 2026
000000BC:             ; ;
000000BC:             ; ;       This library includes the following functions for the display:
000000BC:             ; ;       - moveCursor(): moves the cursor to the second line of the display
000000BC:             ; ;       - printString(pointer): cycles through every character of a string until it 
000000BC:             ; ;                   finds the null character and calls another function to print each
000000BC:             ; ;       - waitLcdIdle(): a function that waits and checks for the LCD to be idle
000000BC:             ; ;       - lcdSendCommand(): prints a character to the display or clears the display or
000000BC:             ; ;                   moves cursor based on signals
000000BC:             ; ;       - waitingLoop(): a waiting loop to stretch pulse width/ separate enable pulses
000000BC:             ; ;
000000BC:             ; ;       Display documentation: https://cdn.sparkfun.com/assets/9/5/f/7/b/HD44780.pdf
000000BC:             ; ;
000000BC:             ; ;       Known bugs:
000000BC:             ; ;       - none
000000BC:             ; ;
000000BC:             ; ;-----------------------------------------------------------------------------
