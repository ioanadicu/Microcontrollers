000004D0:             ; ; Operating System Initialisation
000004D0:             ; ; Maria-Ioana Dicu
000004D0:             ; ; 1 May 2026
000004D0:             ; ;
000004D0:             ; ; Performs the machine-mode setup needed before entering the user programme.
000004D0:             ; ;
000004D0:             ; ; Responsibilities:
000004D0:             ; ;   - Configure trap handling through MTVEC.
000004D0:             ; ;   - Set up the machine-mode stack through MSCRATCH.
000004D0:             ; ;   - Configure the timer to generate 1 ms interrupts.
000004D0:             ; ;   - Enable timer interrupts through the interrupt controller.
000004D0:             ; ;   - Configure the PIO direction for keypad scanning.
000004D0:             ; ;   - Clear keypad debounce state and FIFO pointers.
000004D0:             ; ;   - Enter user mode using mret.
000004D0:             ; ;
000004D0:             ; ; =============================================================================
