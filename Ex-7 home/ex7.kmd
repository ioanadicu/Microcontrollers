000002A8:             ; 
000002A8: 00000397    ;     la      t2, fifo_tail
000002AC: E7838393    ; 
000002B0: 0003AE03    ;     lw      t3, [t2]               ; t3 = current tail
000002B4:             ; 
000002B4: 03C30263    ;     beq     t1, t3, fifo_empty
000002B8:             ; 
000002B8: 00000E97    ;     la      t4, fifo_buf
000002BC: E54E8E93    ; 
000002C0: 01CE8EB3    ;     add     t4, t4, t3
