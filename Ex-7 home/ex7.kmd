00000260:             ; ; =============================================================================
00000260:             ; ; fifo_put
00000260:             ; ; =============================================================================
00000260:             ; ; Adds one character to the circular FIFO.
00000260:             ; ;
00000260:             ; ; Input:
00000260:             ; ;   a0 = ASCII character to enqueue
00000260:             ; ;
00000260:             ; ; Behaviour:
00000260:             ; ;   - If the FIFO is full, the new character is dropped.
00000260:             ; ;   - fifo_head points to the next write position.
00000260:             ; ;   - fifo_tail points to the next read position.
00000260:             ; ;
00000260:             ; ; Registers used:
00000260:             ; ;   t0-t5
00000260:             ; ; =============================================================================
00000260:             ; 
00000260:             ; fifo_put
00000260: 00000297    ;     la      t0, fifo_head
00000264: EBC28293    ; 
00000268: 0002A303    ;     lw      t1, [t0]               ; t1 = current head
0000026C:             ; 
0000026C: 00000397    ;     la      t2, fifo_tail
00000270: EB438393    ; 
00000274: 0003AE03    ;     lw      t3, [t2]               ; t3 = current tail
00000278:             ; 
00000278: 00130E93    ;     addi    t4, t1, 1
0000027C: 00FEFE93    ;     andi    t4, t4, 0x0F           ; Wrap around 16-byte buffer
00000280:             ; 
00000280: 01CE8C63    ;     beq     t4, t3, fifo_put_done  ; If next head equals tail, FIFO is full
00000284:             ; 
00000284: 00000F17    ;     la      t5, fifo_buf
00000288: E88F0F13    ; 
0000028C: 006F0F33    ;     add     t5, t5, t1
00000290: 00AF0023    ;     sb      a0, [t5]               ; Store character at current head
00000294:             ; 
00000294: 01D2A023    ;     sw      t4, [t0]               ; Update head
00000298:             ; 
00000298:             ; fifo_put_done
00000298: 00008067    ;     ret
0000029C:             ; 
0000029C:             ; 
0000029C:             ; ; =============================================================================
0000029C:             ; ; fifo_get
0000029C:             ; ; =============================================================================
0000029C:             ; ; Removes and returns one character from the circular FIFO.
0000029C:             ; ;
0000029C:             ; ; Output:
0000029C:             ; ;   a0 = next ASCII character, or 0 if the FIFO is empty
0000029C:             ; ;
0000029C:             ; ; Behaviour:
0000029C:             ; ;   - fifo_head == fifo_tail means the FIFO is empty.
0000029C:             ; ;   - The character byte is not cleared from fifo_buf after reading.
0000029C:             ; ;
0000029C:             ; ; Registers used:
0000029C:             ; ;   t0-t4
0000029C:             ; ; =============================================================================
0000029C:             ; 
0000029C:             ; fifo_get
0000029C: 00000297    ;     la      t0, fifo_head
