000002E0:             ; ; Trap and Interrupt Handler
000002E0:             ; ; Maria-Ioana Dicu
000002E0:             ; ; 1 May 2026
000002E0:             ; ;
000002E0:             ; ; Handles traps and interrupts for Exercise 7.
000002E0:             ; ;
000002E0:             ; ; Responsibilities:
000002E0:             ; ;   - Save and restore user context when entering machine mode.
000002E0:             ; ;   - Dispatch synchronous traps using MCAUSE.
000002E0:             ; ;   - Handle user-mode ecalls.
000002E0:             ; ;   - Handle timer interrupts and call the keypad scanner.
000002E0:             ; ;   - Return to user mode using mret.
000002E0:             ; ;
000002E0:             ; ; Ecall services:
000002E0:             ; ;   0   Clear display
000002E0:             ; ;   1   Print character in a0 using LCD control bits in a1
000002E0:             ; ;   2   Print null-terminated string pointed to by a0
000002E0:             ; ;   3   Move cursor to second line
000002E0:             ; ;   4   Get next keypad character from FIFO, returns char in a0 or 0
000002E0:             ; ;
000002E0:             ; ; =============================================================================
