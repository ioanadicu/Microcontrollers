0000007C:             ; 
0000007C:             ;     ; Set enable low
0000007C: 00900293    ;     li      t0, LIGHT | RW 
00000080: 005400A3    ;     sb      t0, LCD_REG_CTRL[s0]
00000084:             ; 
00000084:             ;     ; Separate enable pulses
00000084: 038000EF    ;     call    waiting_loop ; waiting_loop only uses t0 so not saving registers (intentional)
00000088:             ; 
00000088:             ;     ; Repeat while bit 7 high
00000088: 0804F493    ;     andi    s1, s1, LCD_BUSY
0000008C: FE0490E3    ;     bnez    s1, STEP_2
