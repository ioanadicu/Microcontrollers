00000004:             ; 
00000004:             ; MSTATUS_MPIE    EQU     0x80            ; Previous machine interrupt enable
00000004:             ; MIE_MEIE        EQU     0x800           ; Machine external interrupt enable
00000004:             ; 
00000004:             ; 
