000000A0:             ; 
000000A0:             ;     ; Delay to stretch pulse
000000A0: 01C000EF    ;     call    waiting_loop ; waiting_loop only uses t0 so not saving registers (intentional)
000000A4:             ; 
000000A4:             ;     ; Disable signal 0
