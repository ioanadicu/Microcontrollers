0004009C:             ; INCLUDE         UserSpaceLib.s
0004009C:             ; ; =============================================================================
0004009C:             ; ; User Space Screen Routines
0004009C:             ; ; Maria-Ioana Dicu
0004009C:             ; ; 1 May 2026
0004009C:             ; ;
0004009C:             ; ; This file contains helper routines used to print common screens and values
0004009C:             ; ; through the display-related ecalls.
0004009C:             ; ;
0004009C:             ; ; The main purpose of these functions is to keep the main program shorter and
0004009C:             ; ; avoid repeating the same display-printing sequences multiple times.
0004009C:             ; ;
0004009C:             ; ; Functions provided:
0004009C:             ; ;   - printDec(value)
0004009C:             ; ;       Prints an unsigned decimal number digit by digit.
0004009C:             ; ;
0004009C:             ; ;   - displayTime()
0004009C:             ; ;       Prints the current timer values using the display ecalls.
0004009C:             ; ;
0004009C:             ; ;   - displayStartScreen()
0004009C:             ; ;       Prints the start screen.
0004009C:             ; ;
0004009C:             ; ;   - displayPauseScreen()
0004009C:             ; ;       Prints the pause screen.
0004009C:             ; ;
0004009C:             ; ; Notes:
0004009C:             ; ;   - These routines do not directly control the LCD hardware.
0004009C:             ; ;   - They rely on ecalls that perform display operations such as clearing the
0004009C:             ; ;     screen, printing strings, printing characters, and moving to the next line.
0004009C:             ; ; =============================================================================
0004009C:             ; 
0004009C:             ; 
0004009C:             ; ; =============================================================================
0004009C:             ; ; printDec
0004009C:             ; ; =============================================================================
0004009C:             ; ; Prints an unsigned decimal number.
0004009C:             ; ; The digits are extracted using repeated division by 10 and temporarily
0004009C:             ; ; stored on the stack so they can be printed in the correct order.
0004009C:             ; ;
0004009C:             ; ; Input:
0004009C:             ; ;   a0 = integer value to print
0004009C:             ; ;
0004009C:             ; ; Registers used:
0004009C:             ; ;   s0 = working copy of the value
0004009C:             ; ;   s1 = digit counter
0004009C:             ; ; =============================================================================
0004009C:             ; 
0004009C:             ; printDec
0004009C: FF410113    ;     subi    sp, sp, 12
000400A0: 00112423    ;     sw      ra,  8[sp]
000400A4: 00812223    ;     sw      s0,  4[sp]
000400A8: 00912023    ;     sw      s1,  0[sp]
000400AC:             ; 
000400AC: 00050413    ;     mv      s0, a0          ; s0 = value being printed
000400B0: 00000493    ;     li      s1, 0           ; s1 = digit counter
000400B4:             ; 
000400B4:             ;     ; -------------------------------------------------------------------------
000400B4:             ;     ; Special case: value = 0
000400B4:             ;     ; -------------------------------------------------------------------------
000400B4:             ; 
000400B4: 00041A63    ;     bnez    s0, decLoop
000400B8: 03000513    ;     li      a0, '0'
000400BC:             ; 
000400BC: 00100893    ;     li      a7, ECALL_PRINT_CHAR
000400C0: 00000073    ;     ecall 
000400C4:             ;     
000400C4: 03C0006F    ;     j       decDone
000400C8:             ; 
000400C8:             ; 
000400C8:             ; ; -------------------------------------------------------------------------
000400C8:             ; ; Extract digits and push them onto the stack
000400C8:             ; ; -------------------------------------------------------------------------
000400C8:             ; 
000400C8:             ; decLoop
000400C8: 00A00313    ;     li      t1, 10
000400CC: 026472B3    ;     remu    t0, s0, t1      ; t0 = s0 % 10
000400D0: 02645433    ;     divu    s0, s0, t1      ; s0 = s0 / 10
000400D4: 03028293    ;     addi    t0, t0, '0'     ; Convert to ASCII digit
000400D8:             ; 
000400D8: FFC10113    ;     subi    sp, sp, 4
000400DC: 00512023    ;     sw      t0, 0[sp]       ; push digit onto stack
000400E0: 00148493    ;     addi    s1, s1, 1
000400E4: FE0412E3    ;     bnez    s0, decLoop
000400E8:             ; 
000400E8:             ; 
000400E8:             ; ; -------------------------------------------------------------------------
000400E8:             ; ; Pop digits and print them
000400E8:             ; ; -------------------------------------------------------------------------
000400E8:             ; 
000400E8:             ; printLoop
000400E8: 00012503    ;     lw      a0, 0[sp]
000400EC: 00410113    ;     addi    sp, sp, 4
000400F0:             ; 
000400F0: 00100893    ;     li      a7, ECALL_PRINT_CHAR
000400F4: 00000073    ;     ecall 
000400F8:             ; 
000400F8: FFF48493    ;     addi    s1, s1, -1
000400FC: FE0496E3    ;     bnez    s1, printLoop
00040100:             ; 
00040100:             ; decDone
00040100: 00012483    ;     lw      s1,  0[sp]
00040104: 00412403    ;     lw      s0,  4[sp]
00040108: 00812083    ;     lw      ra,  8[sp]
0004010C: 00C10113    ;     addi    sp, sp, 12
00040110: 00008067    ;     ret
