00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; INTR_CTRL       EQU     0x0001_0400
00000004:             ; INTR_EN         EQU     0x04
00000004:             ; INTR_RQ         EQU     0x08
00000004:             ; INTR_MODE       EQU     0x0C
00000004:             ; 
00000004:             ; TIMER_INT       EQU     0b00_0001_0000  ; Timer interrupt source bit
00000004:             ; 
