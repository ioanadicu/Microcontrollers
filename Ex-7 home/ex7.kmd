0000004C:             ; ;   s0 = LCD base address
0000004C:             ; ;   s1 = LCD status
0000004C:             ; ; =============================================================================
0000004C:             ; 
0000004C:             ; lcdSendCommand
0000004C:             ; 
0000004C: FF410113    ;     subi    sp, sp, 12
00000050: 00112423    ;     sw      ra,  8[sp]  ; Save return address
00000054: 00812223    ;     sw      s0,  4[sp]  ; Save callee-saved register
00000058: 00912023    ;     sw      s1,  0[sp]  ; Save callee-saved register
0000005C:             ; 
0000005C:             ;     ; -------------------------------------------------------------------------
0000005C:             ;     ; Wait until LCD is no longer busy
0000005C:             ;     ; -------------------------------------------------------------------------
