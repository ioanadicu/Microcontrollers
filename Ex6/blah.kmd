000400D8:             ;                INCLUDE UserSpaceLib.s
000400D8:             ; ; =============================================================================
000400D8:             ; ; User Space Screen Routines
000400D8:             ; ; Maria-Ioana Dicu
000400D8:             ; ; 12 March 2026
000400D8:             ; ;
000400D8:             ; ; This file contains helper routines used to print common screens and values
000400D8:             ; ; through the display-related ecalls.
000400D8:             ; ;
000400D8:             ; ; The main purpose of these functions is to keep the main program shorter and
000400D8:             ; ; avoid repeating the same display-printing sequences multiple times.
000400D8:             ; ;
000400D8:             ; ; Functions provided:
000400D8:             ; ;   - printDec(value)
000400D8:             ; ;       Prints an unsigned decimal number digit by digit.
000400D8:             ; ;
000400D8:             ; ;   - displayTime()
000400D8:             ; ;       Prints the current timer values using the display ecalls.
000400D8:             ; ;
000400D8:             ; ;   - displayStartScreen()
000400D8:             ; ;       Prints the start screen.
000400D8:             ; ;
000400D8:             ; ;   - displayPauseScreen()
000400D8:             ; ;       Prints the pause screen.
000400D8:             ; ;
000400D8:             ; ; Notes:
000400D8:             ; ;   - These routines do not directly control the LCD hardware.
000400D8:             ; ;   - They rely on ecalls that perform display operations such as clearing the
000400D8:             ; ;     screen, printing strings, printing characters, and moving to the next line.
000400D8:             ; ; =============================================================================
000400D8:             ; 
000400D8:             ; 
000400D8:             ; ; =============================================================================
000400D8:             ; ; printDec
000400D8:             ; ; =============================================================================
000400D8:             ; ; Prints an unsigned decimal number.
000400D8:             ; ; The digits are extracted using repeated division by 10 and temporarily
000400D8:             ; ; stored on the stack so they can be printed in the correct order.
000400D8:             ; ;
000400D8:             ; ; Input:
000400D8:             ; ;   a0 = integer value to print
000400D8:             ; ;
000400D8:             ; ; Registers used:
000400D8:             ; ;   s0 = working copy of the value
000400D8:             ; ;   s1 = digit counter
000400D8:             ; ; =============================================================================
000400D8:             ; 
000400D8:             ; printDec
000400D8: FF410113    ;     subi    sp, sp, 12
000400DC: 00112423    ;     sw      ra,  8[sp]
000400E0: 00812223    ;     sw      s0,  4[sp]
000400E4: 00912023    ;     sw      s1,  0[sp]
000400E8:             ; 
000400E8: 00050413    ;     mv      s0, a0          ; s0 = value being printed
000400EC: 00000493    ;     li      s1, 0           ; s1 = digit counter
000400F0:             ; 
000400F0:             ;     ; -------------------------------------------------------------------------
000400F0:             ;     ; Special case: value = 0
000400F0:             ;     ; -------------------------------------------------------------------------
000400F0:             ; 
000400F0: 00041C63    ;     bnez    s0, decLoop
000400F4: 03000513    ;     li      a0, '0'
000400F8: 00A00593    ;     li      a1, LIGHT | RS
000400FC:             ; 
000400FC: 00100893    ;     li      a7, 1
00040100: 00000073    ;     ecall 
00040104:             ;     
00040104: 0400006F    ;     j       decDone
00040108:             ; 
00040108:             ; 
00040108:             ; ; -------------------------------------------------------------------------
00040108:             ; ; Extract digits and push them onto the stack
00040108:             ; ; -------------------------------------------------------------------------
00040108:             ; 
00040108:             ; decLoop
00040108: 00A00313    ;     li      t1, 10
0004010C: 026472B3    ;     remu    t0, s0, t1      ; t0 = s0 % 10
00040110: 02645433    ;     divu    s0, s0, t1      ; s0 = s0 / 10
00040114: 03028293    ;     addi    t0, t0, '0'     ; Convert to ASCII digit
00040118:             ; 
00040118: FFC10113    ;     subi    sp, sp, 4
0004011C: 00512023    ;     sw      t0, 0[sp]       ; push digit onto stack
00040120: 00148493    ;     addi    s1, s1, 1
00040124: FE0412E3    ;     bnez    s0, decLoop
00040128:             ; 
00040128:             ; 
00040128:             ; ; -------------------------------------------------------------------------
00040128:             ; ; Pop digits and print them
00040128:             ; ; -------------------------------------------------------------------------
00040128:             ; 
00040128:             ; printLoop
00040128: 00012503    ;     lw      a0, 0[sp]
0004012C: 00410113    ;     addi    sp, sp, 4
00040130: 00A00593    ;     li      a1, LIGHT | RS
00040134:             ; 
00040134: 00100893    ;     li      a7, 1
00040138: 00000073    ;     ecall 
0004013C:             ; 
0004013C: FFF48493    ;     addi    s1, s1, -1
00040140: FE0494E3    ;     bnez    s1, printLoop
00040144:             ; 
00040144:             ; decDone
00040144: 00012483    ;     lw      s1,  0[sp]
00040148: 00412403    ;     lw      s0,  4[sp]
0004014C: 00812083    ;     lw      ra,  8[sp]
00040150: 00C10113    ;     addi    sp, sp, 12
00040154: 00008067    ;     ret
