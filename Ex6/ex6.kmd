00000000:             ; ; =============================================================================
00000000:             ; ; Exercise 4: System Calls
00000000:             ; ; Maria-Ioana Dicu
00000000:             ; ; 12 March 2026
00000000:             ; ;
00000000:             ; ; A simple timer application adapted to run in user mode within a primitive OS.
00000000:             ; ; The machine-mode section sets up trap handling and dispatches system calls,
00000000:             ; ; while the user-mode section contains the application logic.
00000000:             ; ;
00000000:             ; ; External libraries:
00000000:             ; ;   - DisplayOperations.s   : LCD routines
00000000:             ; ;   - UserSpaceLib.s        : Screen-printing helpers
00000000:             ; ;
00000000:             ; ; Notes:
00000000:             ; ;   - The display-related logic was moved into helper libraries to reduce
00000000:             ; ;     repetition and keep the main application clearer.
00000000:             ; ; =============================================================================
00000000:             ; 
00000000:             ; 
00000000:             ; ; =============================================================================
00000000:             ; ; OS SECTION
00000000:             ; ; Machine mode
00000000:             ; ; =============================================================================
00000000:             ; 
00000000:             ; ORG                             0x0000_0000
00000000: 0CC0006F    ; j                               initialisation
00000004:             ; 
00000004:             ; INCLUDE         DisplayOperations.s     ; Library with Display Operations
00000004:             ; ; =============================================================================
00000004:             ; ; Display Operations Library
00000004:             ; ; Maria-Ioana Dicu
00000004:             ; ; 12 March 2026
00000004:             ; ;
00000004:             ; ; Provides helper routines for driving the LCD display:
00000004:             ; ;   - printString(pointer)
00000004:             ; ;       Prints a null-terminated string character by character.
00000004:             ; ;   - lcdSendCommand(value, control_signals)
00000004:             ; ;       Sends either data or a command to the LCD.
00000004:             ; ;   - waiting_loop()
00000004:             ; ;       Small delay loop used to stretch pulse width and separate enable pulses.
00000004:             ; ;
00000004:             ; ; Reference:
00000004:             ; ;   HD44780 LCD controller documentation:
00000004:             ; ;   https://cdn.sparkfun.com/assets/9/5/f/7/b/HD44780.pdf
00000004:             ; ;
00000004:             ; ; Notes:
00000004:             ; ;   - Delay value may still need tuning depending on hardware timing.
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
00000004:             ; ; Named constants
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; LCD_DATA        EQU     0x0001_0100         ; Base LCD address
00000004:             ; LCD_BUSY        EQU     0x80                ; Busy flag mask (bit 7)
00000004:             ; DELAY           EQU     0x000690            ; Delay counter value
00000004:             ; SHIFT_NEXT      EQU     0b1100_0000         ; Command to move cursor to second line
00000004:             ; 
00000004:             ; LCD_REG_DATA    EQU     0x0                 ; Data register / status register
00000004:             ; LCD_REG_CTRL    EQU     0x1                 ; Control register
00000004:             ; 
00000004:             ; RW              EQU     0x1                 ; Read/Write control bit
00000004:             ; RS              EQU     0x2                 ; Register Select control bit
00000004:             ; E               EQU     0x4                 ; Enable control bit
00000004:             ; LIGHT           EQU     0x8                 ; Backlight control bit
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
00000004:             ; ; printString
00000004:             ; ; =============================================================================
00000004:             ; ; Prints a null-terminated string to the LCD.
00000004:             ; ;
00000004:             ; ; Input:
00000004:             ; ;   a0 = pointer to string
00000004:             ; ;
00000004:             ; ; Registers used:
00000004:             ; ;   s0 = current string pointer
00000004:             ; ;   s1 = current character
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; printString
00000004: FF410113    ;     subi    sp, sp, 12
00000008: 00112423    ;     sw      ra,  8[sp]  ; Save return address
0000000C: 00812223    ;     sw      s0,  4[sp]  ; Save callee-saved register
00000010: 00912023    ;     sw      s1,  0[sp]  ; Save callee-saved register
00000014:             ; 
00000014: 00050413    ;     mv      s0, a0
00000018: 00040483    ;     lb      s1, [s0]
0000001C:             ; 
0000001C:             ; whileChar
0000001C:             ;     ; Loop until null reached
0000001C: 00048E63    ;     beqz    s1, foundNull
00000020:             ; 
00000020:             ;     ; Print current character
00000020: 00048513    ;     mv      a0, s1
00000024: 00A00593    ;     li      a1, LIGHT | RS
00000028: 024000EF    ;     call    lcdSendCommand
0000002C:             ; 
0000002C:             ;     ; Advance to next character
0000002C: 00140413    ;     addi    s0, s0, 1
00000030: 00040483    ;     lb      s1, [s0]
00000034: FE9FF06F    ;     j       whileChar  
00000038:             ; 
00000038:             ; foundNull
00000038:             ;     ; Restore saved registers and return
00000038: 00012483    ;     lw      s1,  0[sp]
0000003C: 00412403    ;     lw      s0,  4[sp]
00000040: 00812083    ;     lw      ra,  8[sp]
00000044: 00C10113    ;     addi    sp, sp, 12
00000048:             ; 
00000048: 00008067    ;     ret
0000004C:             ; 
0000004C:             ; 
0000004C:             ; ; =============================================================================
0000004C:             ; ; lcdSendCommand
0000004C:             ; ; =============================================================================
0000004C:             ; ; Sends either data or a command to the LCD.
0000004C:             ; ;
0000004C:             ; ; Input:
0000004C:             ; ;   a0 = character or command to send
0000004C:             ; ;   a1 = control signals, with E initially low
0000004C:             ; ;
0000004C:             ; ; Registers used:
0000004C:             ; ;   s0 = LCD base address
0000004C:             ; ;   s1 = LCD status
0000004C:             ; ; =============================================================================
0000004C:             ; 
0000004C:             ; lcdSendCommand
0000004C:             ; 
0000004C: FF410113    ;     subi    sp, sp, 12
00000050: 00112423    ;     sw      ra,  8[sp]  ; Save return address
00000054: 00812223    ;     sw      s0,  4[sp]  ; Save callee-saved register
00000058: 00912023    ;     sw      s1,  0[sp]  ; Save callee-saved register
0000005C:             ; 
0000005C:             ;     ; -------------------------------------------------------------------------
0000005C:             ;     ; Wait until LCD is no longer busy
0000005C:             ;     ; -------------------------------------------------------------------------
0000005C:             ; 
0000005C: 00010437    ;     li s0, LCD_DATA
00000060: 10040413    ; 
00000064:             ; 
00000064:             ;     ; Configure LCD for control read with data bus as input
00000064: 00900293    ;     li      t0, LIGHT | RW 
00000068: 005400A3    ;     sb      t0, LCD_REG_CTRL[s0]
0000006C:             ; 
0000006C:             ; STEP_2
0000006C:             ;     ; Set enable high
0000006C: 00D00293    ;     li      t0, LIGHT | E | RW 
00000070: 005400A3    ;     sb      t0, LCD_REG_CTRL[s0]
00000074:             ; 
00000074:             ;     ; Stretch enable pulse
00000074: 048000EF    ;     call    waiting_loop
00000078:             ; 
00000078:             ;     ; Stretch enable pulse
00000078: 00042483    ;     lw      s1, LCD_REG_DATA[s0]
0000007C:             ; 
0000007C:             ;     ; Set enable low
0000007C: 00900293    ;     li      t0, LIGHT | RW 
00000080: 005400A3    ;     sb      t0, LCD_REG_CTRL[s0]
00000084:             ; 
00000084:             ;     ; Separate enable pulses
00000084:             ;             ; waiting_loop only uses t0 so not saving registers (intentional)  
00000084: 038000EF    ;     call    waiting_loop
00000088:             ; 
00000088:             ;     ; Repeat while bit 7 high
00000088: 0804F493    ;     andi    s1, s1, LCD_BUSY
0000008C: FE0490E3    ;     bnez    s1, STEP_2
00000090:             ; 
00000090:             ; 
00000090:             ;     ; -------------------------------------------------------------------------
00000090:             ;     ; Write data/ command to LCD
00000090:             ;     ; -------------------------------------------------------------------------
00000090:             ; 
00000090:             ;     ; Configure LCD for control read with data bus as output
00000090: 00B400A3    ;     sb      a1, LCD_REG_CTRL[s0]
00000094:             ; 
00000094:             ;     ; Write byte to data register
00000094: 00A42023    ;     sw      a0, LCD_REG_DATA[s0]
00000098:             ; 
00000098:             ;     ; Pulse enable high
00000098: 0045E293    ;     ori     t0, a1, E
0000009C: 005400A3    ;     sb      t0, LCD_REG_CTRL[s0]
000000A0:             ; 
000000A0:             ;     ; Delay to stretch pulse
000000A0:             ;             ; waiting_loop only uses t0 so not saving registers (intentional)
000000A0: 01C000EF    ;     call    waiting_loop
000000A4:             ; 
000000A4:             ;     ; Disable signal 0
000000A4: 00B400A3    ;     sb      a1, LCD_REG_CTRL[s0]
000000A8:             ; 
000000A8:             ;     ; Restore saved registers and return
000000A8: 00012483    ;     lw      s1,  0[sp]
000000AC: 00412403    ;     lw      s0,  4[sp]
000000B0: 00812083    ;     lw      ra,  8[sp]
000000B4: 00C10113    ;     addi    sp, sp, 12
000000B8:             ; 
000000B8: 00008067    ;     ret
