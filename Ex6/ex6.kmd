000400D4:             ; INCLUDE UserSpaceLib.s     ; Library with Display Operations
000400D4:             ; ; =============================================================================
000400D4:             ; ; User Space Screen Routines
000400D4:             ; ; Maria-Ioana Dicu
000400D4:             ; ; 12 March 2026
000400D4:             ; ;
000400D4:             ; ; This file contains helper routines used to print common screens and values
000400D4:             ; ; through the display-related ecalls.
000400D4:             ; ;
000400D4:             ; ; The main purpose of these functions is to keep the main program shorter and
000400D4:             ; ; avoid repeating the same display-printing sequences multiple times.
000400D4:             ; ;
000400D4:             ; ; Functions provided:
000400D4:             ; ;   - printDec(value)
000400D4:             ; ;       Prints an unsigned decimal number digit by digit.
000400D4:             ; ;
000400D4:             ; ;   - displayTime()
000400D4:             ; ;       Prints the current timer values using the display ecalls.
000400D4:             ; ;
000400D4:             ; ;   - displayStartScreen()
000400D4:             ; ;       Prints the start screen.
000400D4:             ; ;
000400D4:             ; ;   - displayPauseScreen()
000400D4:             ; ;       Prints the pause screen.
000400D4:             ; ;
000400D4:             ; ; Notes:
000400D4:             ; ;   - These routines do not directly control the LCD hardware.
000400D4:             ; ;   - They rely on ecalls that perform display operations such as clearing the
000400D4:             ; ;     screen, printing strings, printing characters, and moving to the next line.
000400D4:             ; ; =============================================================================
000400D4:             ; 
000400D4:             ; 
000400D4:             ; ; =============================================================================
000400D4:             ; ; printDec
000400D4:             ; ; =============================================================================
000400D4:             ; ; Prints an unsigned decimal number.
000400D4:             ; ; The digits are extracted using repeated division by 10 and temporarily
000400D4:             ; ; stored on the stack so they can be printed in the correct order.
000400D4:             ; ;
000400D4:             ; ; Input:
000400D4:             ; ;   a0 = integer value to print
000400D4:             ; ;
000400D4:             ; ; Registers used:
000400D4:             ; ;   s0 = working copy of the value
000400D4:             ; ;   s1 = digit counter
000400D4:             ; ; =============================================================================
000400D4:             ; 
000400D4:             ; printDec
000400D4: FF410113    ;     subi    sp, sp, 12
000400D8: 00112423    ;     sw      ra,  8[sp]
000400DC: 00812223    ;     sw      s0,  4[sp]
000400E0: 00912023    ;     sw      s1,  0[sp]
000400E4:             ; 
000400E4: 00050413    ;     mv      s0, a0          ; s0 = value being printed
000400E8: 00000493    ;     li      s1, 0           ; s1 = digit counter
000400EC:             ; 
000400EC:             ;     ; -------------------------------------------------------------------------
000400EC:             ;     ; Special case: value = 0
000400EC:             ;     ; -------------------------------------------------------------------------
000400EC:             ; 
000400EC: 00041C63    ;     bnez    s0, decLoop
000400F0: 03000513    ;     li      a0, '0'
000400F4: 00A00593    ;     li      a1, LIGHT | RS
000400F8:             ; 
000400F8: 00100893    ;     li      a7, 1
000400FC: 00000073    ;     ecall 
00040100:             ;     
00040100: 0400006F    ;     j       decDone
00040104:             ; 
00040104:             ; 
00040104:             ; ; -------------------------------------------------------------------------
00040104:             ; ; Extract digits and push them onto the stack
00040104:             ; ; -------------------------------------------------------------------------
00040104:             ; 
00040104:             ; decLoop
00040104: 00A00313    ;     li      t1, 10
00040108: 026472B3    ;     remu    t0, s0, t1      ; t0 = s0 % 10
0004010C: 02645433    ;     divu    s0, s0, t1      ; s0 = s0 / 10
00040110: 03028293    ;     addi    t0, t0, '0'     ; Convert to ASCII digit
00040114:             ; 
00040114: FFC10113    ;     subi    sp, sp, 4
00040118: 00512023    ;     sw      t0, 0[sp]       ; push digit onto stack
0004011C: 00148493    ;     addi    s1, s1, 1
00040120: FE0412E3    ;     bnez    s0, decLoop
00040124:             ; 
00040124:             ; 
00040124:             ; ; -------------------------------------------------------------------------
00040124:             ; ; Pop digits and print them
00040124:             ; ; -------------------------------------------------------------------------
00040124:             ; 
00040124:             ; printLoop
00040124: 00012503    ;     lw      a0, 0[sp]
00040128: 00410113    ;     addi    sp, sp, 4
0004012C: 00A00593    ;     li      a1, LIGHT | RS
00040130:             ; 
00040130: 00100893    ;     li      a7, 1
00040134: 00000073    ;     ecall 
00040138:             ; 
00040138: FFF48493    ;     addi    s1, s1, -1
0004013C: FE0494E3    ;     bnez    s1, printLoop
00040140:             ; 
00040140:             ; decDone
00040140: 00012483    ;     lw      s1,  0[sp]
00040144: 00412403    ;     lw      s0,  4[sp]
00040148: 00812083    ;     lw      ra,  8[sp]
0004014C: 00C10113    ;     addi    sp, sp, 12
00040150: 00008067    ;     ret
