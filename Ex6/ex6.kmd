00040154:             ; ; =============================================================================
00040154:             ; ; displayTime
00040154:             ; ; =============================================================================
00040154:             ; ; Prints the current timer values using display ecalls.
00040154:             ; ; Extracted from main to keep the main program shorter and clearer.
00040154:             ; ;
00040154:             ; ; Assumes:
00040154:             ; ;   s2 = weeks
00040154:             ; ;   s1 = hours
00040154:             ; ;   s0 = minutes
00040154:             ; ; =============================================================================
00040154:             ; 
00040154:             ; displayTime
00040154: FFC10113    ;     subi    sp, sp, 4
00040158: 00112023    ;     sw      ra, 0[sp]
0004015C:             ; 
0004015C:             ;     ; Clear display
