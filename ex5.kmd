00000004:             ; INCLUDE DisplayOperations.s                 ; Library with Display Operations
00000004:             ; ;-----------------------------------------------------------------------------
00000004:             ; ;       Display Operations Library
00000004:             ; ;       Maria-Ioana Dicu
00000004:             ; ;       19 February 2026
00000004:             ; ;
00000004:             ; ;       This library includes the following functions for the display:
00000004:             ; ;       - moveCursor(): moves the cursor to the second line of the display
00000004:             ; ;       - printString(pointer): cycles through every character of a string until it 
00000004:             ; ;                   finds the null character and calls another function to print each
00000004:             ; ;       - waitLcdIdle(): a function that waits and checks for the LCD to be idle
00000004:             ; ;       - lcdSendCommand(): prints a character to the display or clears the display or
00000004:             ; ;                   moves cursor based on signals
00000004:             ; ;       - waitingLoop(): a waiting loop to stretch pulse width/ separate enable pulses
00000004:             ; ;
00000004:             ; ;       Display documentation: https://cdn.sparkfun.com/assets/9/5/f/7/b/HD44780.pdf
00000004:             ; ;
00000004:             ; ;       Known bugs:
00000004:             ; ;       - none
00000004:             ; ;
00000004:             ; ;-----------------------------------------------------------------------------
00000004:             ; 
00000004:             ; ; Defining names to aid readability
00000004:             ; LCD_DATA        EQU     0x0001_0100         ; address where we write display data
00000004:             ; LCD_CONTROL     EQU     0x0001_0101         ; address where we write control signals for the di
                      ; splay
00000004:             ; MASK7           EQU     0x80                ; mask used to find wether bit 7 set with an AND op
                      ; eraton
00000004:             ; DELAY           EQU     0x009690            ; delay used in the counter
00000004:             ; WRITE_CTRL      EQU     0b1010              ; controls when we want to write a character to the
                      ;  display
00000004:             ; SHIFT_NEXT      EQU     0b1100_0000         ; DB7-DB0 data to move cursor to next line
00000004:             ; MASKPRINT       EQU     0b1111
00000004:             ; AMIN            EQU     'A' - 0x10
00000004:             ;                 align
