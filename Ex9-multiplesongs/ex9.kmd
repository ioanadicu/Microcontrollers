000402A8: 000031D3    ;     defw   12755   ; Pitch 5  (G)
000402AC: 00002C64    ;     defw   11364   ; Pitch 6  (A)
000402B0: 0000278C    ;     defw   10124   ; Pitch 7  (B)
000402B4:             ;     
000402B4: 00002553    ;     defw   9555    ; Pitch 8  (High C)
000402B8: 00002141    ;     defw   8513    ; Pitch 9  (High D)
000402BC: 00001DA0    ;     defw   7584    ; Pitch 10 (High E)
000402C0: 00001BF6    ;     defw   7158    ; Pitch 11 (High F)
000402C4: 000018E9    ;     defw   6377    ; Pitch 12 (High G)
000402C8: 00001632    ;     defw   5682    ; Pitch 13 (High A)
000402CC: 000013C6    ;     defw   5062    ; Pitch 14 (High B)
000402D0:             ;     
000402D0: 000012A9    ;     defw   4777    ; Pitch 15 (Higher C)
000402D4:             ; 
