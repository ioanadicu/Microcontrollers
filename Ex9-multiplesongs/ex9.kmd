000000DC:             ; INCLUDE         Keypad.s
000000DC:             ; ; =============================================================================
000000DC:             ; ; Keypad Library
000000DC:             ; ; Maria-Ioana Dicu
000000DC:             ; ; 8 May 2026
000000DC:             ; ;
000000DC:             ; ; Provides keypad scanning, software debouncing and character buffering.
000000DC:             ; ;
000000DC:             ; ; The keypad is scanned every timer interrupt by activating one output line at a
000000DC:             ; ; time and reading the four input lines. A key press is accepted only after the
000000DC:             ; ; same key has been read as pressed for 8 consecutive scans.
000000DC:             ; ;
000000DC:             ; ; Keypad wiring:
000000DC:             ; ;   - Output lines: bits 8-11
000000DC:             ; ;   - Input lines : bits 12-15
000000DC:             ; ;
000000DC:             ; ; Functions provided:
000000DC:             ; ;   - scan_keyboard()
000000DC:             ; ;       Scans all keypad lines once and updates debounce state.
000000DC:             ; ;
000000DC:             ; ;   - fifo_put(char)
000000DC:             ; ;       Adds a detected key character to the circular buffer.
000000DC:             ; ;
000000DC:             ; ;   - fifo_get()
000000DC:             ; ;       Returns the next buffered key character, or 0 if the buffer is empty.
000000DC:             ; ;
000000DC:             ; ; =============================================================================
000000DC:             ; 
000000DC:             ; 
000000DC:             ; ; =============================================================================
000000DC:             ; ; Keypad lookup tables
000000DC:             ; ; =============================================================================
000000DC:             ; 
000000DC:             ; row_drive_table
000000DC: 00000100    ;     defw    0x00000100      ; Activate output bit 8
000000E0: 00000200    ;     defw    0x00000200      ; Activate output bit 9
000000E4: 00000400    ;     defw    0x00000400      ; Activate output bit 10
000000E8: 00000800    ;     defw    0x00000800      ; Activate output bit 11
000000EC:             ; 
000000EC:             ; key_ascii_table
000000EC: 2A 37 34 31 ;     defb    "*741"          ; Bit 8 active, inputs 12, 13, 14, 15
000000F0: 30 38 35 32 ;     defb    "0852"          ; Bit 9 active, inputs 12, 13, 14, 15
000000F4: 23 39 36 33 ;     defb    "#963"        ; Bit 10 active, inputs 12, 13, 14, 15
000000F8: 43 3D 2D 2B ;     defb    "C=-+"          ; Bit 11 active, inputs 12, 13, 14, 15
000000FC:             ;     align
000000FC:             ; 
000000FC:             ; 
000000FC:             ; ; =============================================================================
000000FC:             ; ; Keypad state
000000FC:             ; ; =============================================================================
000000FC:             ; 
000000FC:             ; key_history
000000FC:             ;     defs    16              ; One 8-bit debounce history per key
0000010C:             ;     align
0000010C:             ; 
0000010C:             ; key_state
0000010C:             ;     defs    16              ; 0 = released, 1 = already counted as pressed
0000011C:             ;     align
0000011C:             ; 
0000011C:             ; 
0000011C:             ; ; =============================================================================
0000011C:             ; ; Key character FIFO
0000011C:             ; ; =============================================================================
0000011C:             ; 
0000011C:             ; fifo_buf
0000011C:             ;     defs    16              ; Circular buffer for detected key characters
0000012C:             ;     align
0000012C:             ; 
0000012C:             ; fifo_head
0000012C: 00000000    ;     defw    0               ; Next write position
00000130:             ; 
00000130:             ; fifo_tail
00000130: 00000000    ;     defw    0               ; Next read position
00000134:             ; 
00000134:             ; 
00000134:             ; ; =============================================================================
00000134:             ; ; scan_keyboard
00000134:             ; ; =============================================================================
00000134:             ; ; Scans the full keypad once.
00000134:             ; ;
00000134:             ; ; For each output line:
00000134:             ; ;   1. Clear all output lines.
00000134:             ; ;   2. Activate one output line.
00000134:             ; ;   3. Read input bits 12-15.
00000134:             ; ;   4. Update each key's debounce history.
00000134:             ; ;   5. Add a character to the FIFO only on a new stable press.
00000134:             ; ;
00000134:             ; ; Debounce rule:
00000134:             ; ;   - history == 0xFF means stable pressed.
00000134:             ; ;   - history == 0x00 means stable released.
00000134:             ; ;
00000134:             ; ; Registers used:
00000134:             ; ;   t0 = output-line index
00000134:             ; ;   t1 = PIO base address
00000134:             ; ;   t2 = mask/table pointer
00000134:             ; ;   t3 = table offset / column mask
00000134:             ; ;   t4 = selected output-line bit pattern
00000134:             ; ;   t5 = current input sample
00000134:             ; ;   t6 = input-line index
00000134:             ; ;   a0-a6 = temporary values and FIFO argument
00000134:             ; ;
00000134:             ; ; =============================================================================
00000134:             ; 
00000134:             ; scan_keyboard
00000134: FFC10113    ;     subi    sp, sp, 4
00000138: 00112023    ;     sw      ra, 0[sp]
0000013C:             ; 
0000013C: 00000293    ;     li      t0, 0                  ; Start with output line 0, corresponding to bit 8
00000140:             ; 
00000140:             ; scan_row_loop
00000140:             ;     ; -------------------------------------------------------------------------
00000140:             ;     ; Clear all output lines before activating the next one
00000140:             ;     ; -------------------------------------------------------------------------
00000140:             ; 
00000140: 00010337    ;     li      t1, PIO_BASE            ; t1 = address of keyboard PIO device
00000144: 30030313    ; 
00000148: 000013B7    ;     li      t2, ROW_MASK            ; t2 = mask for all ouput lines (ROW_MASK = bits 8, 9, 10, 
0000014C: F0038393    ; 11)
00000150: 00732423    ;     sw      t2, PIO_CLR[t1]         ; offset 08, turn OFF all output lines
00000154:             ; 
00000154: 00000013    ;     nop
00000158: 00000013    ;     nop
0000015C: 00000013    ;     nop
00000160: 00000013    ;     nop
00000164:             ; 
00000164:             ; 
00000164:             ;     ; -------------------------------------------------------------------------
00000164:             ;     ; Activate one output line
00000164:             ;     ; -------------------------------------------------------------------------
00000164:             ; 
00000164: 00000397    ;     la      t2, row_drive_table     ; t2 = address of the table containing bit 8, 9, 10, 11
00000168: F7838393    ; 
0000016C: 00229E13    ;     slli    t3, t0, 2               ; Word table offset = output index * 4
00000170: 01C383B3    ;     add     t2, t2, t3              ; t2 now points to correct table entry
00000174: 0003AE83    ;     lw      t4, [t2]                ; Load 0x100, 0x200, 0x400 or 0x800
00000178: 01D32623    ;     sw      t4, PIO_SET[t1]         ; offset 0C = data set, activating the line
0000017C:             ; 
0000017C: 00000013    ;     nop
00000180: 00000013    ;     nop
00000184: 00000013    ;     nop
00000188: 00000013    ;     nop
0000018C:             ; 
0000018C:             ; 
0000018C:             ;     ; -------------------------------------------------------------------------
0000018C:             ;     ; Read input lines
0000018C:             ;     ; -------------------------------------------------------------------------
0000018C:             ; 
0000018C: 00032F03    ;     lw      t5, PIO_DATA[t1]       ; Read PIO pin state
00000190: 0000FE37    ;     li      t3, COL_MASK
00000194: 01CF7F33    ;     and     t5, t5, t3             ; Keep only bits 12-15
00000198: 00CF5F13    ;     srli    t5, t5, 12             ; Move input bits down to bits 0-3
0000019C:             ; 
0000019C: 00000F93    ;     li      t6, 0                  ; Start checking input line 0, original bit 12
000001A0:             ; 
000001A0:             ; 
000001A0:             ; scan_col_loop
000001A0:             ;     ; -------------------------------------------------------------------------
000001A0:             ;     ; Extract current input bit
000001A0:             ;     ; -------------------------------------------------------------------------
000001A0:             ; 
000001A0: 01FF5533    ;     srl     a0, t5, t6             ; Move selected input bit into bit 0
000001A4: 00157513    ;     andi    a0, a0, 1              ; a0 = 1 if this key is currently active
000001A8:             ; 
000001A8:             ; 
000001A8:             ;     ; -------------------------------------------------------------------------
000001A8:             ;     ; Calculate key index
000001A8:             ;     ; -------------------------------------------------------------------------
000001A8:             ; 
000001A8: 00229593    ;     slli    a1, t0, 2              ; output_index * 4
000001AC: 01F585B3    ;     add     a1, a1, t6             ; key_index = output_index * 4 + input_index
000001B0:             ; 
000001B0:             ; 
000001B0:             ;     ; -------------------------------------------------------------------------
000001B0:             ;     ; Update debounce history
000001B0:             ;     ; -------------------------------------------------------------------------
000001B0:             ; 
000001B0: 00000617    ;     la      a2, key_history
000001B4: F4C60613    ; 
000001B8: 00B60633    ;     add     a2, a2, a1             ; Point to history byte for this key
000001BC: 00064683    ;     lbu     a3, [a2]               ; Load previous 8-bit history
000001C0:             ; 
000001C0: 00169693    ;     slli    a3, a3, 1              ; Shift previous samples left
000001C4: 00A6E6B3    ;     or      a3, a3, a0             ; Insert newest sample into bit 0
000001C8: 0FF6F693    ;     andi    a3, a3, 0xFF           ; Keep only 8 samples
000001CC: 00D60023    ;     sb      a3, [a2]               ; Store updated history
000001D0:             ; 
000001D0:             ; 
000001D0:             ;     ; -------------------------------------------------------------------------
000001D0:             ;     ; Load stable state for this key
000001D0:             ;     ; -------------------------------------------------------------------------
000001D0:             ; 
000001D0: 00000717    ;     la      a4, key_state
000001D4: F3C70713    ; 
000001D8: 00B70733    ;     add     a4, a4, a1             ; Point to state byte for this key
000001DC: 00074783    ;     lbu     a5, [a4]               ; 0 = released, 1 = already pressed
000001E0:             ; 
000001E0:             ; 
000001E0:             ;     ; -------------------------------------------------------------------------
000001E0:             ;     ; Detect new stable press
000001E0:             ;     ; -------------------------------------------------------------------------
000001E0:             ; 
000001E0: 0FF00813    ;     li      a6, 0xFF
000001E4: 05069463    ;     bne     a3, a6, check_key_release
000001E8: 04079863    ;     bnez    a5, next_key           ; Already counted, so do not repeat
000001EC:             ; 
000001EC: 00100793    ;     li      a5, 1
000001F0: 00F70023    ;     sb      a5, [a4]               ; Mark key as pressed
000001F4:             ; 
000001F4:             ; 
000001F4:             ;     ; -------------------------------------------------------------------------
000001F4:             ;     ; Translate key position into ASCII character
000001F4:             ;     ; -------------------------------------------------------------------------
000001F4:             ; 
000001F4: 00000817    ;     la      a6, key_ascii_table     ; a6 = address of the table that maps key position to chara
000001F8: EF880813    ; cter
000001FC: 00B80833    ;     add     a6, a6, a1              ; a6 = address of the character for this key index
00000200: 00084503    ;     lbu     a0, [a6]                ; a0 = ASCII character for this key
