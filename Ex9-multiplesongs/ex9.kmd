000401B0: 00000073    ;     ecall
000401B4:             ; 
000401B4:             ; play_loop
000401B4:             ;     ; Fetch Pitch (Byte 0) and Duration (Byte 1)
000401B4: 00044283    ;     lbu     t0, 0[s0]           
000401B8:             ;     
000401B8:             ;     ; Check for End of Tune (0xFF / 255)
000401B8: 0FF00E13    ;     li      t3, 255
000401BC: 07C28E63    ;     beq     t0, t3, end_song
000401C0:             ; 
000401C0:             ;     ; Fetch Duration and convert to milliseconds
000401C0: 00144383    ;     lbu     t2, 1[s0]           
000401C4: 06400E13    ;     li      t3, 100
000401C8: 03C383B3    ;     mul     t2, t2, t3          
000401CC:             ; 
000401CC:             ;     ; Check for Rest (Pitch 0)
000401CC: 02028663    ;     beqz    t0, play_rest
000401D0:             ; 
000401D0:             ;     ; Look up the base period from the LUT
000401D0: FFF28293    ;     addi    t0, t0, -1          
000401D4: 00229293    ;     slli    t0, t0, 2           
000401D8:             ;     
000401D8: 00000E97    ;     la      t4, note_lut        
000401DC: 0C0E8E93    ; 
000401E0: 005E8EB3    ;     add     t4, t4, t0          
000401E4: 000EAF83    ;     lw      t6, 0[t4]           
000401E8:             ; 
