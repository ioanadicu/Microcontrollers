0000052C:             ; INCLUDE         OS.s
0000052C:             ; ; =============================================================================
0000052C:             ; ; Operating System Initialisation
0000052C:             ; ; Maria-Ioana Dicu
0000052C:             ; ; 8 May 2026
0000052C:             ; ;
0000052C:             ; ; Performs the machine-mode setup needed before entering the user programme.
0000052C:             ; ;
0000052C:             ; ; Responsibilities:
0000052C:             ; ;   - Configure trap handling through MTVEC.
0000052C:             ; ;   - Set up the machine-mode stack through MSCRATCH.
0000052C:             ; ;   - Configure the timer to generate 1 ms interrupts.
0000052C:             ; ;   - Enable timer interrupts through the interrupt controller.
0000052C:             ; ;   - Configure the PIO direction for keypad scanning.
0000052C:             ; ;   - Clear keypad debounce state and FIFO pointers.
0000052C:             ; ;   - Enter user mode using mret.
0000052C:             ; ;
0000052C:             ; ; =============================================================================
0000052C:             ; 
0000052C:             ; 
0000052C:             ; ; =============================================================================
0000052C:             ; ; Initialisation
0000052C:             ; ; =============================================================================
0000052C:             ; 
0000052C:             ; initialisation
0000052C:             ;     ; -------------------------------------------------------------------------
0000052C:             ;     ; Prepare to enter user mode
0000052C:             ;     ; -------------------------------------------------------------------------
0000052C:             ; 
0000052C: 001892B7    ;     li      t0, mppMask
00000530: 67F28293    ; 
00000534: 3002B073    ;     csrc    MSTATUS, t0            ; Clear MPP bits so mret enters user mode
00000538:             ; 
00000538: 00000297    ;     la      t0, mhandler
0000053C: DB828293    ; 
00000540: 30529073    ;     csrw    MTVEC, t0              ; Set trap/interrupt handler entry point
00000544:             ; 
00000544: 00000297    ;     la      t0, mstack_base
00000548: 1F828293    ; 
0000054C: 34029073    ;     csrw    MSCRATCH, t0           ; Store machine stack pointer in MSCRATCH
00000550:             ; 
00000550:             ; 
00000550:             ;     ; -------------------------------------------------------------------------
00000550:             ;     ; Timer setup: 1 ms interrupt period
00000550:             ;     ; -------------------------------------------------------------------------
00000550:             ; 
00000550: 00010337    ;     li      t1, TIME_PERIPH
00000554: 20030313    ; 
00000558: 3E700293    ;     li      t0, SCAN_MODULUS
0000055C: 00532223    ;     sw      t0, TIME_REG_LIMIT[t1] ; Timer modulus = SCAN_MODULUS + 1
00000560:             ; 
00000560: 00B00293    ;     li      t0, 0b1011
00000564: 00532A23    ;     sw      t0, TIME_REG_CTRL[t1]  ; Enable timer, modulus mode and interrupts
00000568:             ; 
