KMD
00000000:             ; ; =============================================================================
00000000:             ; ; Exercise 9: Music Player
00000000:             ; ; Maria-Ioana Dicu
00000000:             ; ; 8 May 2026
00000000:             ; ;
00000000:             ; ; This program acts as a virtual machine that interprets song data (tunes).
00000000:             ; ; It supports:
00000000:             ; ;   - Keypad selection for multiple songs (tune1.s, tune2.s)
00000000:             ; ;   - Pitch and duration interpretation via a Look-Up Table (LUT)
00000000:             ; ;   - Note separators for staccato articulation
00000000:             ; ;   - Hardware-driven timing using OS system calls
00000000:             ; ;   - User interruption via SW1 to return to the main menu
00000000:             ; ;
00000000:             ; ; Hardware Requirement: Custom Verilog User_Peripheral (Buzzer)
00000000:             ; ; =============================================================================
00000000:             ; 
00000000:             ; ORG             0x0000_0000
00000000: 52C0006F    ; j               initialisation
00000004:             ; 
00000004:             ; INCLUDE         Definitions.s
00000004:             ; ; =============================================================================
00000004:             ; ; Definitions
00000004:             ; ; Maria-Ioana Dicu
00000004:             ; ; 8 May 2026
00000004:             ; ;
00000004:             ; ; Shared constants used by the Exercise 9 operating-system code, trap handler,
00000004:             ; ; timer setup, interrupt controller and memory-mapped I/O routines.
00000004:             ; ;
00000004:             ; ; This file contains only compile-time constants. It does not reserve memory or
00000004:             ; ; contain executable code.
00000004:             ; ;
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
00000004:             ; ; General bit masks
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; bit0            EQU     0x0000_0001
00000004:             ; bit31           EQU     0x8000_0000
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
00000004:             ; ; Machine status / interrupt control constants
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; mppMask         EQU     0x18967F        ; Mask used to clear MPP bits before mret
00000004:             ; 
00000004:             ; MSTATUS_MPIE    EQU     0x80            ; Previous machine interrupt enable
00000004:             ; MIE_MEIE        EQU     0x800           ; Machine external interrupt enable
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
00000004:             ; ; Interrupt controller
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; INTR_CTRL       EQU     0x0001_0400
00000004:             ; INTR_EN         EQU     0x04
00000004:             ; INTR_RQ         EQU     0x08
00000004:             ; INTR_MODE       EQU     0x0C
00000004:             ; 
00000004:             ; TIMER_INT       EQU     0b00_0001_0000  ; Timer interrupt source bit
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
00000004:             ; ; Timer peripheral
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; TIME_PERIPH     EQU     0x0001_0200
00000004:             ; 
00000004:             ; TIME_REG_LIMIT  EQU     0x04
00000004:             ; TIME_REG_STATUS EQU     0x0C
00000004:             ; TIME_REG_CMD    EQU     0x10
00000004:             ; TIME_REG_CTRL   EQU     0x14
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
00000004:             ; ; Parallel I/O peripheral
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; PIO_BASE        EQU     0x0001_0300
00000004:             ; 
00000004:             ; PIO_DATA        EQU     0x00
00000004:             ; PIO_DIR         EQU     0x04
00000004:             ; PIO_CLR         EQU     0x08
00000004:             ; PIO_SET         EQU     0x0C
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
00000004:             ; ; LCD command constants
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; CLEAR_DIS       EQU     0b0000_0001
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
00000004:             ; ; Keypad scan configuration
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; ROW_MASK        EQU     0x00000F00      ; Bits 8-11 are keypad output lines
00000004:             ; COL_MASK        EQU     0x0000F000      ; Bits 12-15 are keypad input lines
00000004:             ; 
00000004:             ; KEY_DIR         EQU     0x0000F000      ; Bits 12-15 input, all other bits output
00000004:             ; 
00000004:             ; SCAN_MODULUS    EQU     999             ; 1 ms interrupt period, assuming 1 us timer ticks
00000004:             ; 
00000004:             ; 
00000004:             ; ; =============================================================================
00000004:             ; ; Ecall numbers
00000004:             ; ; =============================================================================
00000004:             ; 
00000004:             ; ECALL_CLEAR_DISPLAY     EQU     0
00000004:             ; ECALL_PRINT_CHAR        EQU     1
00000004:             ; ECALL_PRINT_STRING      EQU     2
00000004:             ; ECALL_NEXT_LINE         EQU     3
00000004:             ; ECALL_GET_KEY           EQU     4
00000004:             ; ECALL_PLAY_NOTE         EQU     5
00000004:             ; ECALL_READ_BUTTONS      EQU     6
00000004:             ; 
00000004:             ; 
