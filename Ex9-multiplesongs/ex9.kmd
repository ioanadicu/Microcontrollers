000400BC:             ; INCLUDE         UserSpaceLib.s
000400BC:             ; ; =============================================================================
000400BC:             ; ; User Space Screen Routines
000400BC:             ; ; Maria-Ioana Dicu
000400BC:             ; ; 8 May 2026
000400BC:             ; ;
000400BC:             ; ; This file contains helper routines used to print common screens and values
000400BC:             ; ; through the display-related ecalls.
000400BC:             ; ;
000400BC:             ; ; The main purpose of these functions is to keep the main program shorter and
000400BC:             ; ; avoid repeating the same display-printing sequences multiple times.
000400BC:             ; ;
000400BC:             ; ; Functions provided:
000400BC:             ; ;   - printDec(value)
000400BC:             ; ;       Prints an unsigned decimal number digit by digit.
000400BC:             ; ;
000400BC:             ; ;   - displayTime()
000400BC:             ; ;       Prints the current timer values using the display ecalls.
000400BC:             ; ;
000400BC:             ; ;   - displayStartScreen()
000400BC:             ; ;       Prints the start screen.
000400BC:             ; ;
000400BC:             ; ;   - displayPauseScreen()
000400BC:             ; ;       Prints the pause screen.
000400BC:             ; ;
000400BC:             ; ; =============================================================================
000400BC:             ; 
000400BC:             ; 
000400BC:             ; ; =============================================================================
000400BC:             ; ; printDec
000400BC:             ; ; =============================================================================
000400BC:             ; ; Prints an unsigned decimal number.
000400BC:             ; ; The digits are extracted using repeated division by 10 and temporarily
000400BC:             ; ; stored on the stack so they can be printed in the correct order.
000400BC:             ; ;
000400BC:             ; ; Input:
000400BC:             ; ;   a0 = integer value to print
000400BC:             ; ;
000400BC:             ; ; Registers used:
000400BC:             ; ;   s0 = working copy of the value
000400BC:             ; ;   s1 = digit counter
000400BC:             ; ; =============================================================================
000400BC:             ; 
000400BC:             ; printDec
000400BC: FF410113    ;     subi    sp, sp, 12
000400C0: 00112423    ;     sw      ra,  8[sp]
000400C4: 00812223    ;     sw      s0,  4[sp]
000400C8: 00912023    ;     sw      s1,  0[sp]
000400CC:             ; 
000400CC: 00050413    ;     mv      s0, a0          ; s0 = value being printed
000400D0: 00000493    ;     li      s1, 0           ; s1 = digit counter
000400D4:             ; 
000400D4:             ;     ; -------------------------------------------------------------------------
000400D4:             ;     ; Special case: value = 0
000400D4:             ;     ; -------------------------------------------------------------------------
000400D4:             ; 
000400D4: 00041A63    ;     bnez    s0, decLoop
000400D8: 03000513    ;     li      a0, '0'
000400DC:             ; 
000400DC: 00100893    ;     li      a7, ECALL_PRINT_CHAR
000400E0: 00000073    ;     ecall 
000400E4:             ;     
000400E4: 03C0006F    ;     j       decDone
000400E8:             ; 
000400E8:             ; 
000400E8:             ; ; -------------------------------------------------------------------------
000400E8:             ; ; Extract digits and push them onto the stack
000400E8:             ; ; -------------------------------------------------------------------------
000400E8:             ; 
000400E8:             ; decLoop
000400E8: 00A00313    ;     li      t1, 10
000400EC: 026472B3    ;     remu    t0, s0, t1      ; t0 = s0 % 10
000400F0: 02645433    ;     divu    s0, s0, t1      ; s0 = s0 / 10
000400F4: 03028293    ;     addi    t0, t0, '0'     ; Convert to ASCII digit
000400F8:             ; 
000400F8: FFC10113    ;     subi    sp, sp, 4
000400FC: 00512023    ;     sw      t0, 0[sp]       ; push digit onto stack
00040100: 00148493    ;     addi    s1, s1, 1
00040104: FE0412E3    ;     bnez    s0, decLoop
00040108:             ; 
00040108:             ; 
00040108:             ; ; -------------------------------------------------------------------------
00040108:             ; ; Pop digits and print them
00040108:             ; ; -------------------------------------------------------------------------
00040108:             ; 
00040108:             ; printLoop
00040108: 00012503    ;     lw      a0, 0[sp]
0004010C: 00410113    ;     addi    sp, sp, 4
00040110:             ; 
00040110: 00100893    ;     li      a7, ECALL_PRINT_CHAR
00040114: 00000073    ;     ecall 
00040118:             ; 
00040118: FFF48493    ;     addi    s1, s1, -1
0004011C: FE0496E3    ;     bnez    s1, printLoop
00040120:             ; 
00040120:             ; decDone
00040120: 00012483    ;     lw      s1,  0[sp]
00040124: 00412403    ;     lw      s0,  4[sp]
00040128: 00812083    ;     lw      ra,  8[sp]
0004012C: 00C10113    ;     addi    sp, sp, 12
00040130: 00008067    ;     ret
00040134:             ; 
