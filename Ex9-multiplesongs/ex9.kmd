000401E8: 000F8513    ;     mv      a0, t6                  ; Put half-period in a0
000401EC: 00500893    ;     li      a7, ECALL_PLAY_NOTE
000401F0: 00000073    ;     ecall
000401F4: 0100006F    ;     j       wait_duration
000401F8:             ; 
000401F8:             ; play_rest
000401F8: 00000513    ;     li      a0, 0                   ; Period 0 = Silence
000401FC: 00500893    ;     li      a7, ECALL_PLAY_NOTE
00040200: 00000073    ;     ecall
00040204:             ; 
00040204:             ; wait_duration
00040204:             ;     ; Delay for the note's duration
00040204: 00038513    ;     mv      a0, t2
00040208: 040000EF    ;     call    delay_ms
0004020C:             ; 
0004020C:             ;     ; If delay aborted, return to menu
0004020C: 0FF00293    ;     li      t0, 0xFF
00040210: F25502E3    ;     beq     a0, t0, menu_start
00040214:             ; 
00040214:             ;     ; Note Separator (Tiny gap of silence)
00040214: 00000513    ;     li      a0, 0
00040218: 00500893    ;     li      a7, ECALL_PLAY_NOTE
0004021C: 00000073    ;     ecall
00040220:             ;     
00040220: 00F00513    ;     li      a0, 15                  ; 15 ms articulation gap
00040224: 024000EF    ;     call    delay_ms
00040228:             ; 
00040228: 0FF00293    ;     li      t0, 0xFF
0004022C: F05504E3    ;     beq     a0, t0, menu_start
00040230:             ; 
00040230:             ;     ; Move pointer to next note pair and loop
00040230: 00240413    ;     addi    s0, s0, 2           
00040234: F81FF06F    ;     j       play_loop
00040238:             ; 
00040238:             ; end_song
00040238: 00000513    ;     li      a0, 0                   ; Ensure buzzer is off at the end
0004023C: 00500893    ;     li      a7, ECALL_PLAY_NOTE
00040240: 00000073    ;     ecall
00040244: EF1FF06F    ;     j       menu_start              ; Return to homescreen after the song ends
00040248:             ; 
00040248:             ; 
00040248:             ; ; =============================================================================
00040248:             ; ; Helper: Sleep with SW1 Interrupt Check
00040248:             ; ; -----------------------------------------------------------------------------
00040248:             ; ; Input: a0 = duration to wait (ms)
00040248:             ; ; Output: a0 = 1 if SW1 pressed, 0 otherwise
00040248:             ; ; =============================================================================
00040248:             ; delay_ms
00040248: 02050A63    ;     beqz    a0, delay_done
0004024C:             ; 
0004024C: 00050E13    ;     mv      t3, a0                  ; t3 = remaining ms counter (preserve across ecalls)
00040250:             ; 
00040250:             ; delay_ms_loop
00040250: 00000297    ;     la      t0, timer_ticks
00040254: DBC28293    ; 
00040258: 0002A303    ;     lw      t1, [t0]                ; Snapshot the current 1 ms tick
0004025C:             ; 
