00040268: 00000073    ;     ecall
0004026C:             ; 
0004026C: 00157513    ;     andi    a0, a0, BTTN1
00040270: 00051A63    ;     bnez    a0, delay_abort
00040274:             ; 
00040274: FFFE0E13    ;     subi    t3, t3, 1
00040278: FC0E1CE3    ;     bnez    t3, delay_ms_loop
0004027C:             ; 
0004027C:             ; delay_done
0004027C: 00000513    ;     li      a0, 0                   ; Normal return value 0
00040280: 00008067    ;     ret
00040284:             ; 
00040284:             ; delay_abort
00040284: 00000513    ;     li      a0, 0                   ; Silence buzzer immediately on stop
00040288: 00500893    ;     li      a7, ECALL_PLAY_NOTE
0004028C: 00000073    ;     ecall
00040290:             ; 
